{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    // The agent runs via tsx (see package.json dev/start), so dist/ is never executed.
    // `pnpm build` is a typecheck only: noEmit avoids generating non-portable .d.ts for
    // the imported Convex API (TS2742) and stops compiled JS leaking into convex/.
    "noEmit": true,
    "paths": {
      "@convex/*": ["../convex/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

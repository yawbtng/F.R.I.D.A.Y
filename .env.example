# ═══════════════════════════════════════════════
# Browserbase — the cloud browser fleet
# Get at: https://www.browserbase.com/settings
# ═══════════════════════════════════════════════
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...

# Residential proxies for bot-walled sites (state registries etc). OFF by default —
# proxies bill per GB, so flip on deliberately, per run, not permanently.
# BB_PROXIES=1

# ═══════════════════════════════════════════════
# Vercel AI Gateway — realtime voice (WebSocket)
# Get at: https://vercel.com/ai-gateway
# NOTE: the model MUST be WebSocket-available on the Gateway. openai/gpt-realtime-mini
# is (verified); openai/gpt-realtime and the 4o-realtime previews mint tokens but 400
# the WS upgrade. Check with: apps/web/scripts/verify-realtime-token.ts
# ═══════════════════════════════════════════════
AI_GATEWAY_API_KEY=
REALTIME_MODEL=openai/gpt-realtime-mini

# ═══════════════════════════════════════════════
# OpenRouter — planner / report / diagram LLMs (OpenAI-compatible API)
# Get at: https://openrouter.ai/settings/keys
# ═══════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-...
# Optional per-role model overrides (sensible defaults are in code):
# PLANNER_MODEL=openai/gpt-4.1
# SUMMARY_MODEL=openai/gpt-4.1-mini
# DIAGRAM_MODEL=openai/gpt-4.1-mini

# ═══════════════════════════════════════════════
# Stagehand — the model that drives each browser (via Browserbase Model Gateway)
# ═══════════════════════════════════════════════
# STAGEHAND_MODEL=openai/gpt-4.1-mini

# ═══════════════════════════════════════════════
# Exa — web search used when a plan target has no known URL
# Get at: https://dashboard.exa.ai
# ═══════════════════════════════════════════════
EXA_API_KEY=...

# ═══════════════════════════════════════════════
# Internal: browser-route authentication (session-scoped JWTs)
# Generate with: openssl rand -hex 32
# ═══════════════════════════════════════════════
AGENT_API_SECRET=...

# ═══════════════════════════════════════════════
# App URL (used by headless verify scripts to reach the API routes)
# ═══════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════
# Convex — OPTIONAL screenshot/session persistence side-channel.
# Leave unset to skip (run history persists to localStorage either way).
# Auto-configured by `npx convex dev` if you want it.
# ═══════════════════════════════════════════════
# NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

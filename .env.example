# ═══════════════════════════════════════════════
# Browserbase / Stagehand
# Get these at: https://www.browserbase.com/settings
# ═══════════════════════════════════════════════
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...

# ═══════════════════════════════════════════════
# OpenRouter — LLM provider for the agent (grok-4.1-fast via OpenAI-compatible API)
# Get at: https://openrouter.ai/settings/keys
# ═══════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-...

# ═══════════════════════════════════════════════
# Anthropic — used by Stagehand for page understanding (act, extract, observe)
# Get at: https://console.anthropic.com
# ═══════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...

# ═══════════════════════════════════════════════
# Exa — AI-native web search API
# Get at: https://dashboard.exa.ai
# ═══════════════════════════════════════════════
EXA_API_KEY=...

# ═══════════════════════════════════════════════
# AI Gateway — realtime voice (Vercel AI SDK realtime hook)
# Get at: https://vercel.com/ai-gateway
# ═══════════════════════════════════════════════
AI_GATEWAY_API_KEY=
REALTIME_MODEL=openai/gpt-realtime

# ═══════════════════════════════════════════════
# Convex — real-time database
# Auto-configured by `npx convex dev`
# ═══════════════════════════════════════════════
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# ═══════════════════════════════════════════════
# Internal: Agent ↔ API route authentication
# Generate with: openssl rand -hex 32
# ═══════════════════════════════════════════════
AGENT_API_SECRET=...

# ═══════════════════════════════════════════════
# Next.js public URL (for agent worker to call API routes)
# ═══════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
